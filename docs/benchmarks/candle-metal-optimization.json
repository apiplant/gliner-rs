  "decision": {
    "status": "retain_swift_mlx",
    "condition": "Remove Swift inference only if output, performance and memory are comparable.",
    "summary": "Retain both backends. Optimized Candle Metal preserves output agreement and reduces latency and long-suite physical memory peaks; MLX still has lower median latency on all six requests per device.",
    "rationale": "Relative to original Candle, median latency falls 18–31% on Mac and 13–31% on iPhone. MLX remains 7–18% lower on Mac and 18–23% lower on iPhone. Single mixed long-suite runs show 21–28% lower Candle physical peaks, while short-request physical peaks change little. Large RSS reductions from streaming weights are not equivalent to physical memory savings. These are local measurements, not a universal backend ranking."
  },
  "implementation": {
    "metal_weight_loading": "Stream (default): validate safetensors header and read weights without mapping the full file. iOS reads into exact-size shared buffers; macOS uses private buffers with at most 16 MiB of shared staging. Original mmap remains independently selectable. Persistent weight uploads were already exact-size in the original path.",
    "metal_attention": "F32 CustomOp3 kernel fuses content/relative score addition, two relative gathers, scaling and masking. Base relative indices avoid head-expanded copies; full gather outputs and dense mask-floor allocation are removed. Content QK and softmax remain dense O(B*heads*T^2). Not FlashAttention. Fast math is disabled; explicit fma matches original scalar scaling.",
    "relative_position_preparation": "Compute the 2*T-1 unique log-bucket distances, then fill T*T indices; no persistent shape cache.",
    "controls": {
      "cli": [
        "--metal-mmap",
        "--metal-original-attention"
      ],
      "ffi_flags": {
        "0": "stream + optimized attention (default)",
        "1": "mmap + optimized attention",
        "2": "stream + original attention",
        "3": "mmap + original attention"
      },
      "demo": "Rust optimizations switch; changing the option reloads the model after releasing the previous instance."
    },
    "unchanged": "CPU/CUDA loading and arithmetic; Swift/MLX inference implementation. No Candle fork."
  },
